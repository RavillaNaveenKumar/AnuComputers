generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  DISPATCH
  SERVICE_AGENT
  TECHNICIAN
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  NURTURE
  DISQUALIFIED
  CONVERTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TrackingType {
  SERIAL
  QUANTITY
}

enum OrderStatus {
  OPEN
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CrmObjectType {
  STANDARD
  CUSTOM
  SYSTEM
}

enum CrmModule {
  SALES
  SERVICE
  COMMON
}

enum CrmFieldType {
  ID
  TEXT
  TEXT_AREA
  LONG_TEXT_AREA
  NUMBER
  CURRENCY
  PERCENT
  DATE
  DATETIME
  EMAIL
  PHONE
  URL
  CHECKBOX
  PICKLIST
  MULTI_SELECT_PICKLIST
  LOOKUP
  AUTO_NUMBER
}

enum CrmFieldOrigin {
  SYSTEM
  STANDARD
  CUSTOM
}

enum CrmRelationshipType {
  LOOKUP
  ONE_TO_MANY
  MANY_TO_MANY
}

enum CrmObjectDefaultAccess {
  PRIVATE
  PUBLIC_READ_ONLY
  PUBLIC_READ_WRITE
  CONTROLLED_BY_PARENT
}

enum CrmSharingRuleType {
  OWNER
  CRITERIA
}

enum CrmRecordShareAccess {
  READ
  EDIT
}

model User {
  id                           String                       @id
  name                         String
  email                        String                       @unique
  username                     String?                      @unique
  firstName                    String?
  lastName                     String?
  phone                        String?
  emailVerified                Boolean                      @default(false)
  image                        String?
  role                         String                       @default("SALES_EXECUTIVE")
  banned                       Boolean                      @default(false)
  banReason                    String?
  banExpires                   DateTime?
  active                       Boolean                      @default(true)
  mustChangePassword           Boolean                      @default(false)
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  profileId                    String                       @map("profile_id")
  profile                      CrmProfile                   @relation(fields: [profileId], references: [id], onDelete: Restrict)
  hierarchyRoleId              String?                      @map("hierarchy_role_id")
  hierarchyRole                CrmHierarchyRole?            @relation(fields: [hierarchyRoleId], references: [id], onDelete: SetNull)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  sessions                     Session[]
  accounts                     Account[]
  loginHistory                 LoginHistory[]
  assignedLeads                Lead[]                       @relation("LeadAssignee")
  leadActivities               LeadActivity[]               @relation("LeadActivityAuthor")
  createdQuotes                Quote[]                      @relation("QuoteCreator")
  assignedTickets              ServiceTicket[]              @relation("TicketAssignee")
  ticketUpdates                TicketUpdate[]               @relation("TicketUpdateAuthor")
  auditEvents                  AuditEvent[]
  ownedCustomers               Customer[]                   @relation("CustomerOwner")
  createdOrders                Order[]                      @relation("OrderOwner")
  crmRoleAssignments           CrmUsersRole[]
  permissionSetAssignments     CrmPermissionSetAssignment[]
  crmAuditLogs                 CrmAuditLog[]
  ownedCrmRecords              CrmRecord[]                  @relation("CrmRecordOwner")
  createdCrmRecords            CrmRecord[]                  @relation("CrmRecordCreator")
  modifiedCrmRecords           CrmRecord[]                  @relation("CrmRecordModifier")
  createdNativeRecordMetadata  CrmNativeRecordMetadata[]    @relation("CrmNativeRecordCreator")
  modifiedNativeRecordMetadata CrmNativeRecordMetadata[]    @relation("CrmNativeRecordModifier")
  receivedCrmRecordShares      CrmRecordShare[]             @relation("CrmRecordShareUser")
  createdCrmRecordShares       CrmRecordShare[]             @relation("CrmRecordShareCreator")
  receivedNativeRecordShares   CrmNativeRecordShare[]       @relation("CrmNativeRecordShareUser")
  createdNativeRecordShares    CrmNativeRecordShare[]       @relation("CrmNativeRecordShareCreator")
  sharingRulesAsUserTarget     CrmSharingRule[]             @relation("CrmSharingRuleUserTarget")

  @@index([profileId])
  @@index([hierarchyRoleId])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifier    String?
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Customer {
  id        String          @id @default(cuid())
  name      String
  kind      String          @default("BUSINESS")
  email     String?
  phone     String?
  taxId     String?
  notes     String?
  ownerId   String?
  owner     User?           @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  contacts  Contact[]
  addresses Address[]
  leads     Lead[]
  quotes    Quote[]
  orders    Order[]
  units     PurchasedUnit[]
  tickets   ServiceTicket[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  email      String?
  phone      String?
  title      String?
  primary    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Billing")
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Lead {
  id                String         @id @default(cuid())
  reference         String         @unique
  name              String
  email             String?
  phone             String?
  source            String         @default("OTHER")
  interest          String?
  estimatedQuantity Int            @default(1)
  notes             String?
  status            LeadStatus     @default(NEW)
  nextFollowUpAt    DateTime?
  assigneeId        String?
  assignee          User?          @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotes            Quote[]
  activities        LeadActivity[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, nextFollowUpAt])
  @@index([assigneeId, status])
  @@index([phone])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("LeadActivityAuthor", fields: [authorId], references: [id])
  kind      String
  note      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  name             String
  description      String?
  brand            String?
  model            String?
  manufacturerPart String?
  unitPrice        Decimal          @db.Decimal(12, 2)
  trackingType     TrackingType     @default(QUANTITY)
  warrantyMonths   Int              @default(0)
  active           Boolean          @default(true)
  categoryId       String?
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems       QuoteItem[]
  orderItems       OrderItem[]
  units            PurchasedUnit[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([name, brand, model])
  @@index([manufacturerPart])
}

model Quote {
  id              String      @id @default(cuid())
  reference       String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  leadId          String?
  lead            Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User        @relation("QuoteCreator", fields: [createdById], references: [id])
  status          QuoteStatus @default(DRAFT)
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  validUntil      DateTime?
  addressSnapshot Json?
  items           QuoteItem[]
  order           Order?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  skuSnapshot String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([quoteId])
}

model Order {
  id               String          @id @default(cuid())
  reference        String          @unique
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  quoteId          String?         @unique
  quote            Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status           OrderStatus     @default(OPEN)
  invoiceReference String?
  subtotal         Decimal         @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  shippingSnapshot Json?
  ownerId          String?
  owner            User?           @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  shipments        Shipment[]
  tickets          ServiceTicket[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  skuSnapshot String
  description String
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  shipments   ShipmentItem[]
  units       PurchasedUnit[]

  @@index([orderId])
}

model Shipment {
  id          String         @id @default(cuid())
  reference   String         @unique
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  shippedAt   DateTime?
  deliveredAt DateTime?
  carrier     String?
  tracking    String?
  notes       String?
  items       ShipmentItem[]
  createdAt   DateTime       @default(now())

  @@index([orderId])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  delivered   Int       @default(0)
  serials     String[]  @default([])

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model PurchasedUnit {
  id               String          @id @default(cuid())
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  orderItemId      String?
  orderItem        OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  serial           String
  normalizedSerial String
  warrantyStart    DateTime?
  warrantyEnd      DateTime?
  replacedUnitId   String?         @unique
  replacedUnit     PurchasedUnit?  @relation("UnitReplacement", fields: [replacedUnitId], references: [id])
  replacement      PurchasedUnit?  @relation("UnitReplacement")
  ticket           ServiceTicket[]
  createdAt        DateTime        @default(now())

  @@unique([productId, normalizedSerial])
  @@index([customerId])
  @@index([normalizedSerial])
}

model ServiceTicket {
  id               String         @id @default(cuid())
  reference        String         @unique
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  unitId           String?
  unit             PurchasedUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type             String         @default("TECHNICAL")
  title            String
  description      String
  status           TicketStatus   @default(NEW)
  priority         TicketPriority @default(NORMAL)
  waitingReason    String?
  resolutionNote   String?
  diagnosis        String?
  partsUsedNotes   String?
  warrantyDecision String?
  chargeable       Boolean        @default(false)
  customerApproved Boolean        @default(false)
  handoverNotes    String?
  assigneeId       String?
  assignee         User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  updates          TicketUpdate[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  closedAt         DateTime?

  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
  @@index([customerId])
}

model TicketUpdate {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("TicketUpdateAuthor", fields: [authorId], references: [id])
  kind      String
  note      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  operation String
  result    Json
  createdAt DateTime @default(now())
}

model BusinessSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CrmObject {
  id                       String                             @id @default(cuid())
  name                     String
  pluralLabel              String                             @map("plural_label")
  apiName                  String                             @unique @map("api_name")
  description              String?
  objectType               CrmObjectType                      @default(CUSTOM) @map("object_type")
  module                   CrmModule                          @default(COMMON)
  icon                     String                             @default("Database")
  active                   Boolean                            @default(true)
  protected                Boolean                            @default(false)
  displayFieldApiName      String?                            @map("display_field_api_name")
  createdAt                DateTime                           @default(now()) @map("created_at")
  updatedAt                DateTime                           @updatedAt @map("updated_at")
  fields                   CrmField[]
  outgoingRelationships    CrmRelationship[]                  @relation("CrmRelationshipSource")
  incomingRelationships    CrmRelationship[]                  @relation("CrmRelationshipTarget")
  junctionRelationships    CrmRelationship[]                  @relation("CrmRelationshipJunction")
  appAssignments           CrmAppAssignment[]
  pageLayouts               CrmPageLayout[]
  pageLayoutAssignments     CrmPageLayoutAssignment[]
  objectPermissions        CrmObjectPermission[]
  profilePermissions       CrmProfileObjectPermission[]
  permissionSetPermissions CrmPermissionSetObjectPermission[]
  profileTabs              CrmProfileTabPermission[]
  permissionSetTabs        CrmPermissionSetTabPermission[]
  records                  CrmRecord[]
  sharingConfig            CrmSharingConfig?
  sharingRules             CrmSharingRule[]
  nativeRecordShares       CrmNativeRecordShare[]
  nativeRecordMetadata     CrmNativeRecordMetadata[]
  landingForApps           CrmApp[]                           @relation("CrmAppLandingObject")

  @@index([module, objectType, active])
  @@map("crm_objects")
}

model CrmField {
  id                       String                            @id @default(cuid())
  objectId                 String                            @map("object_id")
  object                   CrmObject                         @relation(fields: [objectId], references: [id], onDelete: Cascade)
  label                    String
  apiName                  String                            @map("api_name")
  dataType                 CrmFieldType                      @map("data_type")
  origin                   CrmFieldOrigin                    @default(CUSTOM)
  readOnly                 Boolean                           @default(false) @map("read_only")
  isNameField              Boolean                           @default(false) @map("is_name_field")
  fieldLength              Int?                              @map("field_length")
  decimalPlaces            Int?                              @map("decimal_places")
  externalId               Boolean                           @default(false) @map("external_id")
  lookupTargetApiName      String?                           @map("lookup_target_api_name")
  autoNumberPrefix         String?                           @map("auto_number_prefix")
  autoNumberSuffix         String?                           @map("auto_number_suffix")
  autoNumberStart          Int?                              @map("auto_number_start")
  autoNumberDigits         Int?                              @map("auto_number_digits")
  required                 Boolean                           @default(false)
  defaultValue             String?                           @map("default_value")
  unique                   Boolean                           @default(false)
  description              String?
  helpText                 String?                           @map("help_text")
  protected                Boolean                           @default(false)
  active                   Boolean                           @default(true)
  position                 Int                               @default(0)
  createdAt                DateTime                          @default(now()) @map("created_at")
  updatedAt                DateTime                          @updatedAt @map("updated_at")
  picklistValues           CrmPicklistValue[]
  relationship             CrmRelationship?
  fieldPermissions         CrmFieldPermission[]
  profilePermissions       CrmProfileFieldPermission[]
  permissionSetPermissions CrmPermissionSetFieldPermission[]
  nativeValues             CrmNativeFieldValue[]
  autoNumberCounter        CrmAutoNumberCounter?

  @@unique([objectId, apiName])
  @@index([objectId, active, position])
  @@map("crm_fields")
}

model CrmNativeFieldValue {
  id            String   @id @default(cuid())
  objectApiName String   @map("object_api_name")
  recordId      String   @map("record_id")
  fieldId       String   @map("field_id")
  field         CrmField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value         Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([objectApiName, recordId, fieldId])
  @@index([objectApiName, recordId])
  @@map("crm_native_field_values")
}

model CrmAutoNumberCounter {
  fieldId   String   @id @map("field_id")
  field     CrmField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  nextValue BigInt   @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_auto_number_counters")
}

model CrmNativeRecordMetadata {
  id               String    @id @default(cuid())
  objectApiName    String    @map("object_api_name")
  object           CrmObject @relation(fields: [objectApiName], references: [apiName], onDelete: Cascade)
  recordId         String    @map("record_id")
  createdById      String?   @map("created_by_id")
  createdBy        User?     @relation("CrmNativeRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastModifiedById String?   @map("last_modified_by_id")
  lastModifiedBy   User?     @relation("CrmNativeRecordModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastModifiedAt   DateTime  @updatedAt @map("last_modified_at")

  @@unique([objectApiName, recordId])
  @@map("crm_native_record_metadata")
}

model CrmRecord {
  id               String           @id @default(cuid())
  objectId         String           @map("object_id")
  object           CrmObject        @relation(fields: [objectId], references: [id], onDelete: Cascade)
  ownerId          String?          @map("owner_id")
  owner            User?            @relation("CrmRecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById      String?          @map("created_by_id")
  createdBy        User?            @relation("CrmRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastModifiedById String?          @map("last_modified_by_id")
  lastModifiedBy   User?            @relation("CrmRecordModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  data             Json
  shares           CrmRecordShare[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([objectId, updatedAt])
  @@index([ownerId, objectId])
  @@index([createdById, objectId])
  @@index([lastModifiedById, objectId])
  @@map("crm_records")
}

model CrmRelationship {
  id               String              @id @default(cuid())
  sourceObjectId   String              @map("source_object_id")
  sourceObject     CrmObject           @relation("CrmRelationshipSource", fields: [sourceObjectId], references: [id], onDelete: Cascade)
  targetObjectId   String              @map("target_object_id")
  targetObject     CrmObject           @relation("CrmRelationshipTarget", fields: [targetObjectId], references: [id], onDelete: Restrict)
  junctionObjectId String?             @map("junction_object_id")
  junctionObject   CrmObject?          @relation("CrmRelationshipJunction", fields: [junctionObjectId], references: [id], onDelete: SetNull)
  fieldId          String?             @unique @map("field_id")
  field            CrmField?           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  sharingConfig    CrmSharingConfig?   @relation("CrmSharingParentRelationship")
  label            String
  relationshipType CrmRelationshipType @default(LOOKUP) @map("relationship_type")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([sourceObjectId])
  @@index([targetObjectId])
  @@map("crm_relationships")
}

model CrmSharingConfig {
  id                        String                 @id @default(cuid())
  objectId                  String                 @unique @map("object_id")
  object                    CrmObject              @relation(fields: [objectId], references: [id], onDelete: Cascade)
  defaultAccess             CrmObjectDefaultAccess @default(PRIVATE) @map("default_access")
  grantAccessUsingHierarchy Boolean                @default(false) @map("grant_access_using_hierarchy")
  parentRelationshipId      String?                @unique @map("parent_relationship_id")
  parentRelationship        CrmRelationship?       @relation("CrmSharingParentRelationship", fields: [parentRelationshipId], references: [id], onDelete: Restrict)
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  @@map("crm_sharing_configs")
}

model CrmSharingRule {
  id                         String               @id @default(cuid())
  objectId                   String               @map("object_id")
  object                     CrmObject            @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name                       String
  ruleType                   CrmSharingRuleType   @map("rule_type")
  sourceHierarchyRoleId      String?              @map("source_hierarchy_role_id")
  sourceHierarchyRole        CrmHierarchyRole?    @relation("CrmSharingRuleSourceRole", fields: [sourceHierarchyRoleId], references: [id], onDelete: Restrict)
  sourceIncludesSubordinates Boolean              @default(false) @map("source_includes_subordinates")
  criteria                   Json?
  targetUserId               String?              @map("target_user_id")
  targetUser                 User?                @relation("CrmSharingRuleUserTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetHierarchyRoleId      String?              @map("target_hierarchy_role_id")
  targetHierarchyRole        CrmHierarchyRole?    @relation("CrmSharingRuleTargetRole", fields: [targetHierarchyRoleId], references: [id], onDelete: Cascade)
  targetIncludesSubordinates Boolean              @default(false) @map("target_includes_subordinates")
  access                     CrmRecordShareAccess @default(READ)
  active                     Boolean              @default(true)
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  @@unique([objectId, name])
  @@index([objectId, active, ruleType])
  @@index([sourceHierarchyRoleId])
  @@index([targetHierarchyRoleId])
  @@index([targetUserId])
  @@map("crm_sharing_rules")
}

