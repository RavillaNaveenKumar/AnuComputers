{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install CRM dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Prisma client",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"db:generate"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run CRM checks",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd run typecheck && npm.cmd run lint && npm.cmd test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recheck CRM TypeScript",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"typecheck"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "CRM Typecheck",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"typecheck"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start CRM UI preview",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}